<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Allow test project to access internal members -->
  <ItemGroup>
    <InternalsVisibleTo Include="PeasyWare.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <!-- Pinned above the 9.0.13 that Microsoft.Data.SqlClient 7.0.2 pulls in
         transitively. GHSA-846f-f764-76mx / CVE-2026-84008 (High: SignedCms.CheckSignature
         re-parses attacker-controlled X.509 data, quadratic CPU) and GHSA-2fmv-rv2c-59x7 /
         CVE-2026-70162 (Moderate: EnvelopedCms.Decode on Windows) affect 9.0.0-9.0.20 and
         10.0.0-10.0.12; 10.0.13 is the first patched release on the net10.0 line.
         PeasyWare never parses CMS / PKCS#7 itself, so real exposure was effectively nil,
         but a clean NuGetAudit is worth one line. This project is referenced by every
         other one, so the pin flows to all of them. Drop it once SqlClient depends on a
         patched Pkcs on its own. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PeasyWare.Domain\PeasyWare.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Scanning\" />
  </ItemGroup>

</Project>
